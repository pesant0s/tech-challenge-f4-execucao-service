# Banco local do docker compose; em AWS vem do Secrets Manager
DATABASE_URL=postgresql://execucao:execucao@db:5432/execucao
POSTGRES_USER=execucao
POSTGRES_PASSWORD=execucao
POSTGRES_DB=execucao

# SECRET_KEY precisa ser a mesma do OS Service, que emite os tokens
SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-chars
ALGORITHM=HS256
ALLOWED_ORIGINS=["http://localhost:3000"]

# Sem RABBITMQ_URL a API sobe sem consumir comandos nem publicar eventos
RABBITMQ_URL=amqp://oficina:oficina@rabbitmq:5672/%2F

# Sem licença, o agente do New Relic fica desligado
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=tech-challenge-execucao-service

LOG_FORMAT=console
LOG_LEVEL=INFO
